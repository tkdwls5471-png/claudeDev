# MariaDB 접속 정보 (필수)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# 암호화 키 (비워 두면 처음 실행 시 자동 생성되어 이 파일에 기록됨 — 잃어버리면 저장된 비밀번호·API 키를 복호화할 수 없음)
FERNET_KEY=
# Flask 세션 서명 키 (임의의 긴 문자열)
SECRET_KEY=

# 사내 원격 LLM (OpenAI 호환)
REMOTE_LLM_URL=
REMOTE_LLM_MODEL=

# 선택: 동기화 간격(분), LLM 타임아웃(초)
# SYNC_INTERVAL_MIN=2
# LLM_TIMEOUT_SEC=180
